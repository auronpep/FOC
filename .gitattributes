# Normalise line endings so they do not depend on each contributor's
# core.autocrlf setting. Every text blob in this repo is already LF; this
# keeps it that way and makes checkout behaviour explicit.

* text=auto

# Windows script hosts are happiest with CRLF in the working tree.
# (This affects checkout only - the stored blob stays LF.)
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Shell scripts must keep LF or the shebang line breaks.
*.sh text eol=lf

# Binary assets: never diff, never touch line endings.
*.xlsx binary
*.xls  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.zip  binary
